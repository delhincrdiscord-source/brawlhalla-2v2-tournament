# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000
# Neon Postgres connection string — paste yours here
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
ADMIN_PASSWORD=change-me
# any long random string (used to sign admin session cookies)
SESSION_SECRET=some-long-random-string

# Discord webhooks (optional). Create each webhook in your Discord server:
# Channel settings -> Integrations -> Webhooks -> copy URL.
DISCORD_WEBHOOK_STATUS=          # announces registration open / close
DISCORD_WEBHOOK_REGISTRATIONS=   # posts an embed each time a team registers
DISCORD_WEBHOOK_ROUNDS=          # posts an image of each round when it becomes current
